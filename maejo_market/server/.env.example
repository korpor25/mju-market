# LINE Developers Console > ช่อง Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# service account ของ Firebase แปลงเป็น base64 บรรทัดเดียว
# วิธีทำ: firebase console > Project settings > Service accounts > Generate new private key
#   base64 -w0 service-account.json    (Git Bash / Linux)
FIREBASE_SERVICE_ACCOUNT=

# เว็บของเรา — ใช้ทั้งลิงก์ท้ายข้อความและ CORS
APP_URL=https://maejo-market.web.app
ALLOWED_ORIGINS=https://maejo-market.web.app
